{
  "name": "claro-microtools",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:seed:sql": "tsx scripts/generate-seed.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.114.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "agent-browser": "0.38.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "supabase": "2.117.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
